<view class="page">
  <view class="header">
    <view class="brand"><image class="logo" src="/assets/adog-logo.png" mode="aspectFit"></image><text>小红书图文</text></view>
    <button class="home" bindtap="goHome">回到首页</button>
  </view>
  <view xhs:if="{{error}}" class="notice error">{{error}}</view>
  <view xhs:if="{{pack}}" class="card">
    <view class="section-head"><text class="label">本批照片 · {{pack.materials.length}}张</text><button class="text-button" bindtap="nextPack" disabled="{{busy}}">换一批图文</button></view>
    <view class="photos"><image xhs:for="{{photos}}" xhs:key="renderKey" class="photo" src="{{item.url}}" mode="aspectFit" lazy-load="{{false}}" data-index="{{index}}" data-batch="{{item.batchId}}" data-epoch="{{item.epoch}}" bindtap="previewPhoto" binderror="onPhotoError" bindload="onPhotoLoad"></image></view>
    <view xhs:if="{{imageError}}" class="notice error">{{imageError}}</view>
    <view class="section-head copy-head"><text class="label">对应文案 <text class="count">{{variant}}/{{variantCount}}</text></text><button xhs:if="{{variantCount > 1}}" class="text-button" bindtap="anotherCopy" disabled="{{busy}}">换文案</button></view>
    <input class="title-input" value="{{draft.title}}" bindinput="onTitleInput" maxlength="-1" placeholder="标题，可直接修改"></input>
    <textarea class="body-input" value="{{draft.body}}" bindinput="onBodyInput" maxlength="-1" placeholder="正文，可直接修改"></textarea>
    <view class="copy-foot"><text>按自己的真实经历修改</text><text>{{draft.title.length}}/20 · {{draft.body.length}}/1000</text></view>
    <view xhs:if="{{draftError}}" class="notice error">{{draftError}}</view>
    <view xhs:if="{{prepareError}}" class="notice error">{{prepareError}}</view>
    <view class="publish-area">
      <post-note-button xhs:if="{{nativeEnabled && publisher && !busy}}"
        type="default" size="large"
        title="{{publisher.title}}" content="{{publisher.content}}" media-info="{{publisher.mediaInfo}}"
        miniapp-session-info="{{sessionInfo}}" binderror="onPostError"
      />
      <button xhs:else class="publish-disabled" disabled="true">{{busy ? '正在读取图文…' : (!nativeEnabled ? '去发布（待接通）' : (prepareBusy ? '正在准备图文…' : (draftError ? '请检查文案' : ((prepareError || !leaseValid) ? '请刷新本批后重试' : '正在准备图文…'))))}}</button>
      <button class="refresh" bindtap="refreshPublisher" disabled="{{busy}}">刷新本批</button>
    </view>
    <view class="small-note">进入小红书编辑页后，由你确认并发布。AI辅助整理的内容请按平台要求声明。</view>
  </view>
  <view xhs:if="{{!pack}}" class="empty card">
    <image class="xhs-logo" src="/assets/xhs.jpg" mode="aspectFit"></image>
    <view>{{busy ? '正在读取门店图文…' : '暂时没有可用图文'}}</view>
    <button xhs:if="{{!busy}}" class="retry" bindtap="start">重新读取</button>
  </view>
  <view xhs:if="{{hint}}" class="notice">{{hint}}</view>
  <view xhs:if="{{!nativeEnabled}}" class="small-note pending">当前尚未接通小红书原生编辑页。</view>
</view>
